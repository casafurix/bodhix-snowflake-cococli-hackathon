{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atlas-clinical-trial-copilot",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-08-04",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "SNOWFLAKE_ORIGIN": "https://iaxsmo-pmwcgsc-yq79089.snowflakecomputing.app"
  },
  "secrets": {
    "required": ["SNOWFLAKE_PAT"]
  },
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "41001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "MUTATION_RATE_LIMITER",
      "namespace_id": "41002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "COPILOT_RATE_LIMITER",
      "namespace_id": "41003",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
